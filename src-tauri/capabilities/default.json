{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "StringCraft 主窗口与设置窗口的基础权限",
  "windows": ["float-bar", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize"
  ]
}
